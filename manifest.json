{
  "id": "officer-elections",
  "contexts": ["household", "shared_space"],
  "name": "Officer Elections",
  "version": "1.0.0",
  "description": "Run officer elections with candidate nominations, secret ballots, majority or ranked-choice voting, and formal result certification.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["elections", "voting", "officers", "governance", "org"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "settings": {"sql": "SELECT value AS officials_group_id FROM app_officer_elections__settings WHERE key = 'officials_group_id' LIMIT 1"},
    "oe_elections": {"sql": "SELECT * FROM app_officer_elections__oe_elections ORDER BY created_at DESC LIMIT 200"}
  },
  "db_plaintext_columns": ["voting_deadline", "nominations_deadline", "voting_method"],
  "agenda": {
    "kind": "event",
    "label": "Elections",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, office AS subtitle, CASE WHEN status = 'nominations' THEN nominations_deadline ELSE voting_deadline END AS when_at FROM app_officer_elections__oe_elections WHERE (status = 'voting' AND substr(voting_deadline, 1, 10) = :today) OR (status = 'nominations' AND substr(nominations_deadline, 1, 10) = :today) LIMIT 10"
    }
  },
  "row_policies": {
    "settings": {
      "kind": "app_config"
    },
    "oe_elections": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "officials_group_id" }],
      "frozen_when": { "status_column": "status", "locked_values": ["certified"] }
    },
    "oe_candidates": {
      "kind": "owner_or_visibility",
      "member_column": "nominated_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "officials_group_id" }]
    },
    "oe_ballots": {
      "kind": "endpoint_only",
      "read": "none"
    },
    "oe_ballot_items": {
      "kind": "endpoint_only",
      "read": "none"
    },
    "oe_ballot_receipts": {
      "kind": "owner_only",
      "member_column": "voter_id",
      "adults_bypass": false,
      "member_can_update": false,
      "endpoint_writes_only": true
    }
  },
  "anonymous_ballot": {
    "receipt_table": "oe_ballot_receipts",
    "session_column": "election_id",
    "member_column": "voter_id",
    "created_at_column": "created_at",
    "ballot_table": "oe_ballots",
    "ballot_session_column": "election_id",
    "ballot_id_column": "id",
    "ballot_created_at_column": "created_at",
    "items_table": "oe_ballot_items",
    "item_id_column": "id",
    "ballot_fk_column": "ballot_id",
    "candidate_column": "candidate_id",
    "rank_column": "rank",
    "session_table": "oe_elections",
    "session_id_column": "id",
    "session_status_column": "status",
    "session_open_values": ["voting"],
    "result_visible_values": ["closed", "certified"],
    "session_deadline_column": "voting_deadline",
    "session_voting_method_column": "voting_method",
    "majority_method_values": ["majority"],
    "ranked_method_values": ["ranked_choice"],
    "candidate_table": "oe_candidates",
    "candidate_session_column": "election_id",
    "candidate_id_column": "id"
  },
  "notification_acls": {
    "send": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "officials_group_id" }
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_officer_elections__oe_elections e LEFT JOIN app_officer_elections__oe_ballot_receipts r ON r.election_id = e.id WHERE e.status = 'voting' AND r.voter_id IS NULL LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "ballots waiting for you",
      "severity": "warn"
    }
  },
  "publishes": ["election.voting_opened", "election.certified"],
  "publish_acls": {
    "election.voting_opened": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "officials_group_id" }
    },
    "election.certified": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "officials_group_id" }
    }
  },
  "suggested_automations": [
    {
      "title": "Put the voting deadline on the calendar",
      "description": "When voting opens on an election, put the day ballots close on the org calendar, named for the office. A deadline that lives only inside this app is a deadline people miss — the calendar is where the household already looks, and it rides out to whatever calendar members have subscribed. Only elections with a closing date set announce one.",
      "trigger_event": "election.voting_opened",
      "target_app_id": "calendar",
      "action_id": "create_event",
      "param_map": {
        "title": { "kind": "payload_field", "value": "review_title" },
        "event_date": { "kind": "payload_field", "value": "voting_deadline" },
        "description": { "kind": "payload_field", "value": "summary" },
        "source_ref_id": { "kind": "payload_field", "value": "source_ref_id" }
      }
    },
    {
      "title": "Take the voting deadline back off the calendar",
      "description": "The other half of the rule above, and it does nothing on its own. Once results are certified the closing date is spent, so the entry that rule put on the calendar stops showing instead of standing there as a deadline the household still has to meet. Add both, or every finished election leaves its deadline behind.",
      "trigger_event": "election.certified",
      "target_app_id": "calendar",
      "action_id": "retract_dated_event",
      "param_map": {
        "source_ref_id": { "kind": "payload_field", "value": "source_ref_id" }
      }
    }
  ],
  "admin_config": {
    "settings_table": "settings",
    "keys": ["officials_group_id"]
  },
  "member_references": {
    "oe_elections": [
      { "column": "created_by", "on_removed": "keep" },
      { "column": "certified_by", "on_removed": "keep" }
    ],
    "oe_candidates": [
      { "column": "member_id", "on_removed": "keep" },
      { "column": "nominated_by", "on_removed": "keep" }
    ],
    "oe_ballot_receipts": { "column": "voter_id", "on_removed": "keep" }
  },
  "resource_limits": { "max_db_bytes": 52428800 },
  "nav": { "label": "Elections" },
  "icon": "🗳️"
}
